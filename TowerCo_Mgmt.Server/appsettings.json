{
  "ConnectionStrings": {
    "TowerCoDb": "Data Source=towerco.db"
  },
  "Dashboard": {
    "RenewalWindowDays": 90,
    "RenewalCriticalDays": 30
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Health": {
    "TelemetryWindowDays": 30,
    "InspectionWarningMonths": 12,
    "InspectionCriticalMonths": 24
  },
  "AlarmThresholds": {
    "BatteryVoltage": {
      "Warning": 48,
      "Critical": 46,
      "Direction": "LowIsBad"
    },
    "ShelterTemperature": {
      "Warning": 35,
      "Critical": 45,
      "Direction": "HighIsBad"
    },
    "GeneratorFuelLevel": {
      "Warning": 30,
      "Critical": 15,
      "Direction": "LowIsBad"
    },
    "TowerTilt": {
      "Warning": 0.5,
      "Critical": 1.0,
      "Direction": "HighIsBad"
    }
  }
}
