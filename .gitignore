# .NET build output
[Bb]in/
[Oo]bj/
[Dd]ebug/
[Rr]elease/
*.nupkg
*.snupkg

# Visual Studio and IDE state
.vs/
.vscode/*
!.vscode/launch.json
.idea/
*.user
*.suo
*.userprefs
*.rsuser

# Test results and coverage
TestResults/
coverage/
*.coverage
*.coveragexml
coverage*.json
coverage*.xml

