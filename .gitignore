!TowerCo_Mgmt.Server/towerco.db

# Local settings and environment files (may hold machine or secret values)
local.settings.json
.env
.env.*
!.env.example
appsettings.*.local.json
*.local

# Certificates and keys
*.pfx
*.pem
*.key

# Node and Vite client
node_modules/
dist/
*.tsbuildinfo
npm-debug.log*
yarn-error.log*

# Tooling scratch output
.playwright-mcp/
.harness_check/

# OS files
.DS_Store
Thumbs.db
